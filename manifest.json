{
  "schemaVersion": 1,
  "id": "io.github.marty-schneider.sports-tracker",
  "name": "Sports Tracker",
  "version": "0.8.2",
  "author": "Marty Schneider",
  "license": "MIT",
  "description": "Sports Tracker: CS2, NFL, NBA, MLB, NHL, Premier League, Serie A, Ligue 1, La Liga, Sumo, and GT World Challenge.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "Sports Tracker",
    "description": "CS2, NFL, NBA, MLB, NHL, Premier League, Serie A, Ligue 1, La Liga, Sumo, and GT World Challenge. Countdown pill, local-time schedule, pinned player and team.",
    "category": "Info",
    "aliases": ["cs", "cs2", "nfl", "nba", "mlb", "nhl", "epl", "premier", "seriea", "ligue1", "laliga", "sumo", "gt", "gtworld", "sports", "sports-tracker", "tracker"],
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "timeFormat": "24-hour",
      "autoLive": true,
      "liveRefreshSec": 12,
      "refreshMinutes": 15,
      "notifications": true,
      "notifyLeadMinutes": "30,15",
      "defaultSport": "auto",
      "csHighlightPlayer": "donk",
      "csHighlightTeam": "Spirit",
      "sumoHighlightPlayer": "Onosato",
      "sumoHighlightTeam": "Nishonoseki",
      "gtHighlightPlayer": "",
      "gtHighlightTeam": "Mercedes"
    },
    "schema": [
      {
        "key": "timeFormat",
        "type": "enum",
        "label": "Time format",
        "options": ["24-hour", "12-hour"],
        "defaultValue": "24-hour"
      },
      {
        "key": "defaultSport",
        "type": "enum",
        "label": "Default sport",
        "options": ["auto", "cs", "nfl", "nba", "mlb", "nhl", "epl", "seriea", "ligue1", "laliga", "sumo", "gt"],
        "defaultValue": "auto"
      },
      {
        "key": "autoLive",
        "type": "boolean",
        "label": "Switch to live mode automatically",
        "defaultValue": true
      },
      {
        "key": "liveRefreshSec",
        "type": "integer",
        "label": "Live refresh interval (seconds)",
        "min": 5,
        "max": 120,
        "step": 1,
        "defaultValue": 12
      },
      {
        "key": "refreshMinutes",
        "type": "integer",
        "label": "Standings refresh interval (minutes)",
        "min": 5,
        "max": 720,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "notifications",
        "type": "boolean",
        "label": "Desktop notifications",
        "defaultValue": true
      },
      {
        "key": "notifyLeadMinutes",
        "type": "string",
        "label": "Notify this many minutes before",
        "defaultValue": "30,15"
      },
      {
        "key": "csHighlightPlayer",
        "type": "string",
        "label": "Pinned CS player",
        "defaultValue": "donk"
      },
      {
        "key": "csHighlightTeam",
        "type": "string",
        "label": "Pinned CS team",
        "defaultValue": "Spirit"
      },
      {
        "key": "sumoHighlightPlayer",
        "type": "string",
        "label": "Pinned rikishi",
        "defaultValue": "Onosato"
      },
      {
        "key": "sumoHighlightTeam",
        "type": "string",
        "label": "Pinned sumo rank band",
        "defaultValue": "Nishonoseki"
      },
      {
        "key": "gtHighlightPlayer",
        "type": "string",
        "label": "Pinned GT driver",
        "defaultValue": ""
      },
      {
        "key": "gtHighlightTeam",
        "type": "string",
        "label": "Pinned GT manufacturer/team",
        "defaultValue": "Mercedes"
      }
    ]
  }
}
